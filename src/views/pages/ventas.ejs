<% layout('layout') -%>
<header class="mb-6 md:mb-8 flex flex-col md:flex-row justify-between md:items-end gap-4">
  <div>
    <h2 class="text-2xl md:text-3xl font-bold text-white mb-1 flex items-center gap-3">
      <span class="w-10 h-10 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-lg shadow-lg shadow-emerald-500/30">
        <i class="ph-fill ph-receipt"></i>
      </span>
      Ventas
    </h2>
    <p class="text-slate-400 text-sm">Historial y gestión de ventas registradas</p>
  </div>
  <div class="flex items-center gap-2">
    <button onclick="openQuickSale()" class="flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-emerald-500 to-teal-500 text-white rounded-xl font-semibold text-sm hover:shadow-lg hover:shadow-emerald-500/25 transition-all active:scale-95">
      <i class="ph-fill ph-plus-circle text-lg"></i> Nueva Venta
    </button>
  </div>
</header>

<!-- ═══════════════ SALES KPI ROW ═══════════════ -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 mb-4">
  <!-- Ventas Hoy -->
  <div class="glass-card rounded-2xl p-4 md:p-5 flex items-center gap-3 relative overflow-hidden group card-hover cursor-default">
    <div class="absolute -right-4 -top-4 w-20 h-20 bg-emerald-500/10 rounded-full blur-2xl group-hover:bg-emerald-500/20 transition-all"></div>
    <div class="w-10 h-10 rounded-xl bg-emerald-500/15 text-emerald-400 flex items-center justify-center text-lg shrink-0 border border-emerald-500/10">
      <i class="ph-fill ph-shopping-cart"></i>
    </div>
    <div class="min-w-0">
      <p class="text-slate-500 text-[10px] font-semibold uppercase tracking-wider mb-0.5">Hoy</p>
      <h3 class="text-lg md:text-xl font-bold text-white tracking-tight" id="kpi-sales-today">
        <span class="skeleton-text w-16 h-5"></span>
      </h3>
    </div>
  </div>
  <!-- Ventas Semana -->
  <div class="glass-card rounded-2xl p-4 md:p-5 flex items-center gap-3 relative overflow-hidden group card-hover cursor-default">
    <div class="absolute -right-4 -top-4 w-20 h-20 bg-blue-500/10 rounded-full blur-2xl group-hover:bg-blue-500/20 transition-all"></div>
    <div class="w-10 h-10 rounded-xl bg-blue-500/15 text-blue-400 flex items-center justify-center text-lg shrink-0 border border-blue-500/10">
      <i class="ph-fill ph-calendar-dots"></i>
    </div>
    <div class="min-w-0">
      <p class="text-slate-500 text-[10px] font-semibold uppercase tracking-wider mb-0.5">Semana</p>
      <h3 class="text-lg md:text-xl font-bold text-white tracking-tight" id="kpi-sales-week">
        <span class="skeleton-text w-16 h-5"></span>
      </h3>
    </div>
  </div>
  <!-- Ventas Mes -->
  <div class="glass-card rounded-2xl p-4 md:p-5 flex items-center gap-3 relative overflow-hidden group card-hover cursor-default">
    <div class="absolute -right-4 -top-4 w-20 h-20 bg-purple-500/10 rounded-full blur-2xl group-hover:bg-purple-500/20 transition-all"></div>
    <div class="w-10 h-10 rounded-xl bg-purple-500/15 text-purple-400 flex items-center justify-center text-lg shrink-0 border border-purple-500/10">
      <i class="ph-fill ph-chart-line-up"></i>
    </div>
    <div class="min-w-0">
      <p class="text-slate-500 text-[10px] font-semibold uppercase tracking-wider mb-0.5">Mes</p>
      <h3 class="text-lg md:text-xl font-bold text-white tracking-tight" id="kpi-sales-month">
        <span class="skeleton-text w-16 h-5"></span>
      </h3>
    </div>
  </div>
  <!-- Ganancia del mes -->
  <div class="glass-card rounded-2xl p-4 md:p-5 flex items-center gap-3 relative overflow-hidden group card-hover cursor-default">
    <div class="absolute -right-4 -top-4 w-20 h-20 bg-amber-500/10 rounded-full blur-2xl group-hover:bg-amber-500/20 transition-all"></div>
    <div class="w-10 h-10 rounded-xl bg-amber-500/15 text-amber-400 flex items-center justify-center text-lg shrink-0 border border-amber-500/10">
      <i class="ph-fill ph-coin"></i>
    </div>
    <div class="min-w-0">
      <p class="text-slate-500 text-[10px] font-semibold uppercase tracking-wider mb-0.5">Ganancia Mes</p>
      <h3 class="text-lg md:text-xl font-bold text-white tracking-tight" id="kpi-profit-month">
        <span class="skeleton-text w-16 h-5"></span>
      </h3>
    </div>
  </div>
</div>

<!-- ═══════════════ CHART + PAYMENT METHODS ═══════════════ -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-3 md:gap-4 mb-4">
  <!-- 7-day chart (2 cols) -->
  <div class="lg:col-span-2 glass-card rounded-2xl p-5 md:p-6 relative overflow-hidden">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-9 h-9 rounded-xl bg-indigo-500/15 text-indigo-400 flex items-center justify-center border border-indigo-500/10">
        <i class="ph-fill ph-chart-bar text-lg"></i>
      </div>
      <h4 class="text-sm font-bold text-white">Ventas Últimos 7 Días</h4>
    </div>
    <div class="relative h-[220px] md:h-[250px]">
      <canvas id="salesDailyChart"></canvas>
    </div>
  </div>
  <!-- Payment methods breakdown -->
  <div class="glass-card rounded-2xl p-5 md:p-6 relative overflow-hidden">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-9 h-9 rounded-xl bg-teal-500/15 text-teal-400 flex items-center justify-center border border-teal-500/10">
        <i class="ph-fill ph-credit-card text-lg"></i>
      </div>
      <h4 class="text-sm font-bold text-white">Métodos de Pago</h4>
    </div>
    <div class="relative h-[220px] md:h-[250px] flex items-center justify-center">
      <canvas id="paymentMethodChart"></canvas>
      <div id="paymentChartEmpty" class="hidden absolute inset-0 flex flex-col items-center justify-center">
        <i class="ph-duotone ph-credit-card text-4xl text-slate-600 mb-2"></i>
        <p class="text-slate-500 text-sm">Sin datos aún</p>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════ FILTERS BAR ═══════════════ -->
<div class="glass-card rounded-2xl p-4 mb-4">
  <div class="grid grid-cols-1 lg:grid-cols-5 gap-3">
    <!-- Search -->
    <div class="relative lg:col-span-2">
      <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-500"></i>
      <input type="text" id="salesSearch" placeholder="Buscar por producto..." class="w-full pl-10 pr-4 py-2.5 bg-slate-800/50 border border-slate-700/50 rounded-xl text-white text-sm placeholder-slate-500 focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/20 transition-all">
    </div>
    <!-- Date From -->
    <div class="relative">
      <input type="text" onfocus="(this.type='date')" onblur="if(!this.value)this.type='text'" id="salesDateFrom" placeholder="Fecha desde" class="w-full px-4 py-2.5 bg-slate-800/50 border border-slate-700/50 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500/50 transition-all placeholder-slate-500" style="color-scheme: dark;">
    </div>
    <!-- Date To -->
    <div class="relative">
      <input type="text" onfocus="(this.type='date')" onblur="if(!this.value)this.type='text'" id="salesDateTo" placeholder="Fecha hasta" class="w-full px-4 py-2.5 bg-slate-800/50 border border-slate-700/50 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500/50 transition-all placeholder-slate-500" style="color-scheme: dark;">
    </div>
    <!-- Payment Method & Clear -->
    <div class="relative flex gap-2">
      <select id="salesPaymentFilter" class="flex-1 px-4 py-2.5 bg-slate-800/50 border border-slate-700/50 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500/50 transition-all appearance-none cursor-pointer" style="color-scheme: dark;">
        <option value="">Todos los métodos</option>
        <!-- Populated dynamically by JS -->
      </select>
      <button onclick="clearSalesFilters()" class="px-3 bg-slate-800/50 border border-slate-700/50 rounded-xl text-slate-400 hover:text-white hover:border-indigo-500/30 transition-all shrink-0 flex items-center justify-center" title="Limpiar filtros">
        <i class="ph ph-funnel-x text-lg"></i>
      </button>
    </div>
  </div>
</div>

<!-- ═══════════════ SALES LIST ═══════════════ -->
<div class="glass-card rounded-2xl overflow-hidden">
  <!-- Header -->
  <div class="hidden md:grid grid-cols-12 gap-4 px-6 py-3 border-b border-slate-700/30 text-[10px] font-bold text-slate-500 uppercase tracking-wider">
    <div class="col-span-1">ID</div>
    <div class="col-span-3">Productos</div>
    <div class="col-span-2">Total</div>
    <div class="col-span-2">Ganancia</div>
    <div class="col-span-2">Método</div>
    <div class="col-span-1">Fecha</div>
    <div class="col-span-1 text-right">Acciones</div>
  </div>

  <div id="salesListContainer" class="divide-y divide-slate-800/50">
    <!-- skeleton items -->
    <div class="p-6 text-center text-slate-500">
      <div class="flex flex-col items-center justify-center py-8">
        <i class="ph-duotone ph-receipt text-4xl text-slate-600 mb-3"></i>
        <p class="text-sm font-medium">Cargando ventas...</p>
      </div>
    </div>
  </div>

  <!-- Pagination -->
  <div id="salesPagination" class="flex items-center justify-between px-6 py-3 border-t border-slate-700/30">
    <p class="text-xs text-slate-500" id="salesPaginationInfo">--</p>
    <div class="flex items-center gap-1" id="salesPaginationBtns"></div>
  </div>
</div>

<!-- ═══════════════ SALE DETAIL MODAL ═══════════════ -->
<div id="saleDetailModal" class="fixed inset-0 z-[60] hidden">
  <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" onclick="closeSaleDetail()"></div>
  <div class="absolute inset-4 md:inset-auto md:top-1/2 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2 md:w-full md:max-w-lg bg-slate-900 border border-slate-700/50 rounded-3xl overflow-hidden flex flex-col max-h-[90vh]">
    <div class="flex items-center justify-between p-5 border-b border-slate-800/50">
      <h3 class="text-lg font-bold text-white flex items-center gap-2">
        <i class="ph-fill ph-receipt text-emerald-400"></i> Detalle de Venta
      </h3>
      <button onclick="closeSaleDetail()" class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-700 transition-colors">
        <i class="ph ph-x text-lg"></i>
      </button>
    </div>
    <div class="flex-1 overflow-y-auto no-scrollbar p-5" id="saleDetailContent">
      <!-- Populated by JS -->
    </div>
  </div>
</div>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
