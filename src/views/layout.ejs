<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= pageTitle || 'Dashboard' %> - Admin Lunele</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Phosphor Icons for modern UI icons -->
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body class="flex h-screen overflow-hidden">

  <!-- Sidebar Desktop -->
  <aside class="hidden md:flex flex-col w-64 glass-sidebar h-full z-20 shrink-0">
    <div class="p-6">
      <h1 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-cyan-400 flex items-center gap-2">
        <i class="ph-fill ph-moon-stars text-indigo-400"></i> Lunele
      </h1>
      <p class="text-xs text-slate-500 mt-1 uppercase tracking-widest font-semibold">Workspace</p>
    </div>

    <div class="px-4 mb-6">
      <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-800/50 border border-slate-700/50">
        <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center text-white font-bold text-sm shrink-0 shadow-lg shadow-indigo-500/20">
          <%= user.name.charAt(0).toUpperCase() %>
        </div>
        <div class="flex-1 overflow-hidden">
          <p class="text-sm font-semibold text-white truncate"><%= user.name %></p>
          <p class="text-xs text-indigo-300 truncate"><%= user.role %></p>
        </div>
      </div>
    </div>

    <nav class="flex-1 space-y-1.5 px-3 overflow-y-auto no-scrollbar">
      <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-2 px-3 mt-4">Menú Principal</p>
      
      <a href="/" id="nav-dashboard" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 text-left font-medium no-underline <%= currentPage === 'dashboard' ? 'active' : '' %>">
        <i class="ph ph-squares-four text-xl"></i> Dashboard
      </a>
      <a href="/productos" id="nav-productos" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 text-left font-medium no-underline <%= currentPage === 'productos' ? 'active' : '' %>">
        <i class="ph ph-package text-xl"></i> Productos
      </a>
      <a href="/ventas" id="nav-ventas" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 text-left font-medium no-underline <%= currentPage === 'ventas' ? 'active' : '' %>">
        <i class="ph ph-receipt text-xl"></i> Ventas
      </a>
      <a href="/categorias" id="nav-categorias" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 text-left font-medium no-underline <%= currentPage === 'categorias' ? 'active' : '' %>">
        <i class="ph ph-tag text-xl"></i> Categorías
      </a>
      <a href="/proveedores" id="nav-proveedores" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 text-left font-medium no-underline <%= currentPage === 'proveedores' ? 'active' : '' %>">
        <i class="ph ph-truck text-xl"></i> Proveedores
      </a>
      <a href="/etiquetas" id="nav-etiquetas" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 text-left font-medium no-underline <%= currentPage === 'etiquetas' ? 'active' : '' %>">
        <i class="ph ph-bookmark-simple text-xl"></i> Etiquetas
      </a>
      
      <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-2 px-3 mt-6">Administración</p>

      <% if (user.role === 'Super Admin' || user.role === 'Administrador') { %>
      <a href="/usuarios" id="nav-usuarios" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 text-left font-medium no-underline <%= currentPage === 'usuarios' ? 'active' : '' %>">
        <i class="ph ph-users text-xl"></i> Usuarios
      </a>
      <% } %>
      <a href="/empresa" id="nav-empresa" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 text-left font-medium no-underline <%= currentPage === 'empresa' ? 'active' : '' %>">
        <i class="ph ph-buildings text-xl"></i> Empresa
      </a>
    </nav>

    <div class="p-4 border-t border-slate-800/50 mt-auto">
      <button onclick="logout()" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-red-400 hover:bg-red-400/10 transition-colors text-left font-medium group">
        <i class="ph ph-sign-out text-xl group-hover:-translate-x-1 transition-transform"></i> Cerrar Sesión
      </button>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 flex flex-col h-full relative overflow-hidden bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-slate-800/30 via-slate-900 to-[#0f172a]">
    
    <!-- Topbar Mobile -->
    <header class="md:hidden flex justify-between items-center p-4 glass-nav z-20">
      <h1 class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-cyan-400 flex items-center gap-2">
        <i class="ph-fill ph-moon-stars text-indigo-400"></i> Lunele
      </h1>
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center text-white font-bold text-xs shadow-lg shadow-indigo-500/20">
          <%= user.name.charAt(0).toUpperCase() %>
        </div>
      </div>
    </header>

    <!-- Views Container -->
    <div class="flex-1 overflow-y-auto no-scrollbar p-4 md:p-8 pb-32 md:pb-10">
      <%- body %>
    </div>

    <!-- Bottom Navigation (Mobile) -->
    <nav id="bottomNav" class="fixed bottom-0 left-0 right-0 glass-nav px-2 py-2 flex justify-around items-center z-40 md:hidden pb-safe border-t border-slate-800/80">
      <a href="/" class="nav-item-mobile flex flex-col items-center py-1 px-3 <%= currentPage === 'dashboard' ? 'text-indigo-400' : 'text-slate-500' %> hover:text-indigo-400 transition-colors relative no-underline">
        <% if (currentPage === 'dashboard') { %><div class="absolute -top-1 w-8 h-1 bg-indigo-500 rounded-full"></div><% } %>
        <i class="ph-fill ph-squares-four text-2xl mb-0.5"></i>
        <span class="text-[10px] font-semibold">Inicio</span>
      </a>
      <a href="/productos" class="nav-item-mobile flex flex-col items-center py-1 px-3 <%= currentPage === 'productos' ? 'text-indigo-400' : 'text-slate-500' %> hover:text-indigo-400 transition-colors relative no-underline">
        <% if (currentPage === 'productos') { %><div class="absolute -top-1 w-8 h-1 bg-indigo-500 rounded-full"></div><% } %>
        <i class="ph-fill ph-package text-2xl mb-0.5"></i>
        <span class="text-[10px] font-semibold">Productos</span>
      </a>
      <a href="/ventas" class="nav-item-mobile flex flex-col items-center py-1 px-3 <%= currentPage === 'ventas' ? 'text-emerald-400' : 'text-slate-500' %> hover:text-emerald-400 transition-colors relative no-underline">
        <% if (currentPage === 'ventas') { %><div class="absolute -top-1 w-8 h-1 bg-emerald-500 rounded-full"></div><% } %>
        <i class="ph-fill ph-receipt text-2xl mb-0.5"></i>
        <span class="text-[10px] font-semibold">Ventas</span>
      </a>
      <a href="/categorias" class="nav-item-mobile flex flex-col items-center py-1 px-3 <%= currentPage === 'categorias' ? 'text-indigo-400' : 'text-slate-500' %> hover:text-indigo-400 transition-colors relative no-underline">
        <% if (currentPage === 'categorias') { %><div class="absolute -top-1 w-8 h-1 bg-indigo-500 rounded-full"></div><% } %>
        <i class="ph-fill ph-tag text-2xl mb-0.5"></i>
        <span class="text-[10px] font-semibold">Categorías</span>
      </a>
      <button id="moreMenuBtn" class="nav-item-mobile flex flex-col items-center py-1 px-3 <%= ['etiquetas','usuarios','empresa','proveedores'].includes(currentPage) ? 'text-indigo-400' : 'text-slate-500' %> hover:text-indigo-400 transition-colors relative bg-transparent border-none cursor-pointer">
        <% if (['etiquetas','usuarios','empresa','proveedores'].includes(currentPage)) { %><div class="absolute -top-1 w-8 h-1 bg-indigo-500 rounded-full"></div><% } %>
        <i class="ph-fill ph-dots-three-circle text-2xl mb-0.5"></i>
        <span class="text-[10px] font-semibold">Más</span>
      </button>
    </nav>

    <!-- "More" Overlay Menu (Mobile) -->
    <div id="moreMenuOverlay" class="fixed inset-0 z-50 hidden md:hidden" style="pointer-events:none;">
      <!-- Backdrop -->
      <div id="moreMenuBackdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity duration-300 opacity-0" style="pointer-events:auto;" onclick="closeMoreMenu()"></div>
      <!-- Slide-up Panel -->
      <div id="moreMenuPanel" class="absolute bottom-0 left-0 right-0 rounded-t-3xl border-t border-slate-700/60 overflow-hidden transition-transform duration-300 translate-y-full" style="pointer-events:auto; background: rgba(15,23,42,0.97); backdrop-filter: blur(24px);">
        <!-- Handle bar -->
        <div class="flex justify-center pt-3 pb-1">
          <div class="w-10 h-1 rounded-full bg-slate-600"></div>
        </div>
        <!-- Header -->
        <div class="px-6 pt-2 pb-4 flex items-center justify-between">
          <h3 class="text-base font-bold text-white">Más opciones</h3>
          <button onclick="closeMoreMenu()" class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-700 transition-colors border-none cursor-pointer">
            <i class="ph ph-x text-lg"></i>
          </button>
        </div>
        <!-- Menu Items -->
        <div class="px-4 pb-3 space-y-1">
          <a href="/proveedores" class="more-menu-item flex items-center gap-4 px-4 py-3.5 rounded-2xl transition-all no-underline <%= currentPage === 'proveedores' ? 'bg-indigo-500/15 text-indigo-400' : 'text-slate-300 hover:bg-slate-800/70 hover:text-white' %>">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 <%= currentPage === 'proveedores' ? 'bg-indigo-500/20' : 'bg-slate-800' %>">
              <i class="ph-fill ph-truck text-xl"></i>
            </div>
            <div class="flex-1">
              <p class="text-sm font-semibold m-0">Proveedores</p>
              <p class="text-xs text-slate-500 m-0 mt-0.5">Gestionar proveedores</p>
            </div>
            <i class="ph ph-caret-right text-slate-600"></i>
          </a>
          <a href="/etiquetas" class="more-menu-item flex items-center gap-4 px-4 py-3.5 rounded-2xl transition-all no-underline <%= currentPage === 'etiquetas' ? 'bg-indigo-500/15 text-indigo-400' : 'text-slate-300 hover:bg-slate-800/70 hover:text-white' %>">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 <%= currentPage === 'etiquetas' ? 'bg-indigo-500/20' : 'bg-slate-800' %>">
              <i class="ph-fill ph-bookmark-simple text-xl"></i>
            </div>
            <div class="flex-1">
              <p class="text-sm font-semibold m-0">Etiquetas</p>
              <p class="text-xs text-slate-500 m-0 mt-0.5">Gestionar etiquetas de productos</p>
            </div>
            <i class="ph ph-caret-right text-slate-600"></i>
          </a>
          <% if (user.role === 'Super Admin' || user.role === 'Administrador') { %>
          <a href="/usuarios" class="more-menu-item flex items-center gap-4 px-4 py-3.5 rounded-2xl transition-all no-underline <%= currentPage === 'usuarios' ? 'bg-indigo-500/15 text-indigo-400' : 'text-slate-300 hover:bg-slate-800/70 hover:text-white' %>">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 <%= currentPage === 'usuarios' ? 'bg-indigo-500/20' : 'bg-slate-800' %>">
              <i class="ph-fill ph-users text-xl"></i>
            </div>
            <div class="flex-1">
              <p class="text-sm font-semibold m-0">Usuarios</p>
              <p class="text-xs text-slate-500 m-0 mt-0.5">Administrar equipo y permisos</p>
            </div>
            <i class="ph ph-caret-right text-slate-600"></i>
          </a>
          <% } %>
          <a href="/empresa" class="more-menu-item flex items-center gap-4 px-4 py-3.5 rounded-2xl transition-all no-underline <%= currentPage === 'empresa' ? 'bg-indigo-500/15 text-indigo-400' : 'text-slate-300 hover:bg-slate-800/70 hover:text-white' %>">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 <%= currentPage === 'empresa' ? 'bg-indigo-500/20' : 'bg-slate-800' %>">
              <i class="ph-fill ph-buildings text-xl"></i>
            </div>
            <div class="flex-1">
              <p class="text-sm font-semibold m-0">Empresa</p>
              <p class="text-xs text-slate-500 m-0 mt-0.5">Configuración de la empresa</p>
            </div>
            <i class="ph ph-caret-right text-slate-600"></i>
          </a>
        </div>
        <!-- Divider -->
        <div class="mx-6 border-t border-slate-800/80"></div>
        <!-- Logout -->
        <div class="px-4 py-3 pb-safe">
          <button onclick="logout()" class="more-menu-item flex items-center gap-4 px-4 py-3.5 rounded-2xl w-full text-left transition-all text-red-400 hover:bg-red-500/10 bg-transparent border-none cursor-pointer">
            <div class="w-10 h-10 rounded-xl bg-red-500/10 flex items-center justify-center shrink-0">
              <i class="ph-fill ph-sign-out text-xl"></i>
            </div>
            <div class="flex-1">
              <p class="text-sm font-semibold m-0">Cerrar Sesión</p>
              <p class="text-xs text-red-400/50 m-0 mt-0.5">Salir de la aplicación</p>
            </div>
          </button>
        </div>
      </div>
    </div>
  </main>

  <!-- ═══════════════ FAB — Quick Sale Button ═══════════════ -->
  <button id="fabQuickSale" onclick="openQuickSale()" class="fixed z-[45] w-14 h-14 rounded-full bg-gradient-to-tr from-emerald-500 to-teal-500 text-white shadow-xl shadow-emerald-500/30 flex items-center justify-center hover:shadow-2xl hover:shadow-emerald-500/40 active:scale-90 transition-all group" style="bottom: 80px; right: 16px;" title="Registrar Venta">
    <i class="ph-fill ph-plus text-2xl group-hover:rotate-90 transition-transform duration-300"></i>
    <span class="absolute inset-0 rounded-full bg-emerald-400/20 animate-ping pointer-events-none" style="animation-duration: 3s;"></span>
  </button>

  <!-- ═══════════════ QUICK SALE MODAL ═══════════════ -->
  <div id="quickSaleModal" class="fixed inset-0 z-[70] hidden">
    <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" onclick="closeQuickSale()"></div>
    <div class="absolute inset-0 md:inset-auto md:top-1/2 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2 md:w-full md:max-w-lg md:max-h-[90vh] bg-slate-900 md:border md:border-slate-700/50 md:rounded-3xl overflow-hidden flex flex-col">
      <!-- Header -->
      <div class="flex items-center justify-between p-4 md:p-5 border-b border-slate-800/50 shrink-0">
        <h3 class="text-lg font-bold text-white flex items-center gap-2">
          <span class="w-8 h-8 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-500 flex items-center justify-center text-white text-sm shadow-lg">
            <i class="ph-fill ph-shopping-cart"></i>
          </span>
          Nueva Venta
        </h3>
        <button onclick="closeQuickSale()" class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-700 transition-colors">
          <i class="ph ph-x text-lg"></i>
        </button>
      </div>

      <!-- Body (scrollable) -->
      <div class="flex-1 overflow-y-auto no-scrollbar p-4 md:p-5 space-y-4">

        <!-- Product Search -->
        <div>
          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1.5 block">Agregar Producto</label>
          <div class="relative">
            <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-500"></i>
            <input type="text" id="qsProductSearch" placeholder="Buscar producto..." class="w-full pl-10 pr-4 py-3 bg-slate-800/50 border border-slate-700/50 rounded-xl text-white text-sm placeholder-slate-500 focus:outline-none focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/20 transition-all" autocomplete="off">
            <!-- Search results dropdown -->
            <div id="qsProductDropdown" class="absolute top-full left-0 right-0 mt-1 bg-slate-800 border border-slate-700/50 rounded-2xl overflow-hidden hidden z-10 max-h-52 overflow-y-auto no-scrollbar shadow-2xl shadow-black/50">
            </div>
          </div>
        </div>

        <!-- Cart Items -->
        <div id="qsCartContainer" class="hidden">
          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1.5 block">Productos en la venta</label>
          <div id="qsCartItems" class="space-y-2"></div>
        </div>

        <!-- Payment Method -->
        <div>
          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1.5 block">Método de Pago</label>
          <div class="grid grid-cols-2 gap-2" id="qsPaymentMethods">
            <button type="button" onclick="selectPaymentMethod('Efectivo')" data-method="Efectivo" class="qs-payment-btn flex items-center gap-2.5 p-3 rounded-xl border border-slate-700/50 bg-slate-800/30 text-slate-400 hover:border-emerald-500/30 hover:text-emerald-400 transition-all text-sm font-semibold">
              <i class="ph-fill ph-money text-lg"></i> Efectivo
            </button>
            <button type="button" onclick="selectPaymentMethod('Nequi')" data-method="Nequi" class="qs-payment-btn flex items-center gap-2.5 p-3 rounded-xl border border-slate-700/50 bg-slate-800/30 text-slate-400 hover:border-violet-500/30 hover:text-violet-400 transition-all text-sm font-semibold">
              <i class="ph-fill ph-device-mobile text-lg"></i> Nequi
            </button>
            <button type="button" onclick="selectPaymentMethod('Daviplata')" data-method="Daviplata" class="qs-payment-btn flex items-center gap-2.5 p-3 rounded-xl border border-slate-700/50 bg-slate-800/30 text-slate-400 hover:border-orange-500/30 hover:text-orange-400 transition-all text-sm font-semibold">
              <i class="ph-fill ph-device-mobile-camera text-lg"></i> Daviplata
            </button>
            <button type="button" onclick="selectPaymentMethod('Datafono')" data-method="Datafono" class="qs-payment-btn flex items-center gap-2.5 p-3 rounded-xl border border-slate-700/50 bg-slate-800/30 text-slate-400 hover:border-sky-500/30 hover:text-sky-400 transition-all text-sm font-semibold">
              <i class="ph-fill ph-credit-card text-lg"></i> Datafono
            </button>
          </div>
        </div>

        <!-- Notes -->
        <div>
          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1.5 block">Notas (opcional)</label>
          <textarea id="qsNotes" rows="2" placeholder="Observaciones de la venta..." class="w-full px-4 py-2.5 bg-slate-800/50 border border-slate-700/50 rounded-xl text-white text-sm placeholder-slate-500 focus:outline-none focus:border-emerald-500/50 resize-none transition-all"></textarea>
        </div>
      </div>

      <!-- Footer with totals -->
      <div class="p-4 md:p-5 border-t border-slate-800/50 shrink-0 space-y-3">
        <div class="flex justify-between items-center">
          <span class="text-sm text-slate-400">Total</span>
          <span class="text-2xl font-bold text-white" id="qsTotal">$0</span>
        </div>
        <button id="qsSubmitBtn" onclick="submitQuickSale()" disabled class="w-full py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 text-white font-bold text-sm hover:shadow-lg hover:shadow-emerald-500/25 transition-all disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:shadow-none active:scale-[0.98] flex items-center justify-center gap-2">
          <i class="ph-fill ph-check-circle text-lg"></i> Confirmar Venta
        </button>
      </div>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toastContainer" class="fixed top-4 left-1/2 -translate-x-1/2 z-[100] flex flex-col gap-3 pointer-events-none w-full max-w-[90%] md:max-w-sm"></div>

  <script>
    window.userRole = '<%= user.role %>';

    // ── More Menu (Mobile) ─────────────────────────────────
    function openMoreMenu() {
      const overlay = document.getElementById('moreMenuOverlay');
      const backdrop = document.getElementById('moreMenuBackdrop');
      const panel = document.getElementById('moreMenuPanel');
      overlay.classList.remove('hidden');
      overlay.style.pointerEvents = 'auto';
      requestAnimationFrame(() => {
        backdrop.classList.remove('opacity-0');
        backdrop.classList.add('opacity-100');
        panel.classList.remove('translate-y-full');
        panel.classList.add('translate-y-0');
      });
    }
    function closeMoreMenu() {
      const overlay = document.getElementById('moreMenuOverlay');
      const backdrop = document.getElementById('moreMenuBackdrop');
      const panel = document.getElementById('moreMenuPanel');
      backdrop.classList.remove('opacity-100');
      backdrop.classList.add('opacity-0');
      panel.classList.remove('translate-y-0');
      panel.classList.add('translate-y-full');
      setTimeout(() => {
        overlay.classList.add('hidden');
        overlay.style.pointerEvents = 'none';
      }, 300);
    }
    document.getElementById('moreMenuBtn')?.addEventListener('click', function(e) {
      e.preventDefault();
      openMoreMenu();
    });

    // ── Quick Sale Global Logic ────────────────────────────
    let qsCart = [];
    let qsProducts = [];
    let qsSelectedPayment = null;

    function openQuickSale() {
      qsCart = [];
      qsSelectedPayment = null;
      document.getElementById('qsProductSearch').value = '';
      document.getElementById('qsCartItems').innerHTML = '';
      document.getElementById('qsCartContainer').classList.add('hidden');
      document.getElementById('qsProductDropdown').classList.add('hidden');
      document.getElementById('qsNotes').value = '';
      document.getElementById('qsTotal').textContent = '$0';
      document.getElementById('qsSubmitBtn').disabled = true;
      document.querySelectorAll('.qs-payment-btn').forEach(b => {
        b.classList.remove('border-emerald-500/50', 'bg-emerald-500/10', 'text-emerald-400',
          'border-violet-500/50', 'bg-violet-500/10', 'text-violet-400',
          'border-orange-500/50', 'bg-orange-500/10', 'text-orange-400',
          'border-sky-500/50', 'bg-sky-500/10', 'text-sky-400');
      });
      document.getElementById('quickSaleModal').classList.remove('hidden');
      loadQsProducts();
      setTimeout(() => document.getElementById('qsProductSearch').focus(), 200);
    }

    function closeQuickSale() {
      document.getElementById('quickSaleModal').classList.add('hidden');
    }

    async function loadQsProducts() {
      try {
        const res = await fetch('/api/inventory');
        const json = await res.json();
        if (json.success) qsProducts = json.data.filter(p => p.stock > 0);
      } catch (e) { console.error(e); }
    }

    // Product search
    document.getElementById('qsProductSearch')?.addEventListener('input', function() {
      const q = this.value.toLowerCase().trim();
      const dropdown = document.getElementById('qsProductDropdown');
      if (!q) { dropdown.classList.add('hidden'); return; }

      const cartIds = qsCart.map(c => c.product + (c.colorName || ''));
      const matches = qsProducts.filter(p =>
        (p.name.toLowerCase().includes(q) || (p.sku && p.sku.toLowerCase().includes(q))) &&
        p.stock > 0
      ).slice(0, 8);

      if (!matches.length) {
        dropdown.innerHTML = '<div class="p-4 text-center text-sm text-slate-500">Sin resultados</div>';
      } else {
        dropdown.innerHTML = matches.map(p => {
          const hasColors = p.colors && p.colors.length > 0;
          const colorDots = hasColors ? `<div class="flex items-center gap-0.5 mt-0.5">${p.colors.filter(c => c.stock > 0).map(c => `<span class="w-2.5 h-2.5 rounded-full border border-white/20" style="background-color: ${c.hex};" title="${c.name}: ${c.stock}"></span>`).join('')}</div>` : '';
          if (hasColors) {
            // Show individual color options
            return p.colors.filter(c => c.stock > 0).map(c => {
              const alreadyInCart = qsCart.some(ci => ci.product === p._id && ci.colorName === c.name);
              if (alreadyInCart) return '';
              return `
              <div class="flex items-center justify-between px-4 py-3 hover:bg-slate-700/50 cursor-pointer transition-colors" onclick="addToQsCart('${p._id}', '${c.name.replace(/'/g, "\\'")}')">  
                <div class="min-w-0 flex-1">
                  <p class="text-sm text-white font-medium truncate flex items-center gap-2">${p.name} <span class="w-3 h-3 rounded-full border border-white/20 shrink-0" style="background-color: ${c.hex};"></span> <span class="text-[10px] text-slate-400">${c.name}</span></p>
                  <p class="text-[10px] text-slate-500">Stock: ${c.stock} · $${p.salePrice.toLocaleString('es-CO')}</p>
                </div>
                <i class="ph ph-plus-circle text-lg text-emerald-400 shrink-0 ml-2"></i>
              </div>`;
            }).join('');
          }
          const alreadyInCart = qsCart.some(ci => ci.product === p._id && !ci.colorName);
          if (alreadyInCart) return '';
          return `
          <div class="flex items-center justify-between px-4 py-3 hover:bg-slate-700/50 cursor-pointer transition-colors" onclick="addToQsCart('${p._id}')">
            <div class="min-w-0 flex-1">
              <p class="text-sm text-white font-medium truncate">${p.name}</p>
              <p class="text-[10px] text-slate-500">Stock: ${p.stock} · $${p.salePrice.toLocaleString('es-CO')}</p>
            </div>
            <i class="ph ph-plus-circle text-lg text-emerald-400 shrink-0 ml-2"></i>
          </div>`;
        }).join('');
      }
      dropdown.classList.remove('hidden');
    });

    // Close dropdown on outside click
    document.addEventListener('click', e => {
      const wrap = document.getElementById('qsProductSearch')?.parentElement;
      if (wrap && !wrap.contains(e.target)) {
        document.getElementById('qsProductDropdown')?.classList.add('hidden');
      }
    });

    function addToQsCart(productId, colorName = null) {
      const product = qsProducts.find(p => p._id === productId);
      if (!product) return;

      let itemStock = product.stock;
      let colorHex = null;

      if (colorName && product.colors && product.colors.length > 0) {
        const colorEntry = product.colors.find(c => c.name === colorName);
        if (!colorEntry || colorEntry.stock <= 0) return;
        itemStock = colorEntry.stock;
        colorHex = colorEntry.hex;
      }

      qsCart.push({
        product: product._id,
        name: product.name,
        stock: itemStock,
        salePrice: product.salePrice,
        unitPrice: product.salePrice,
        quantity: 1,
        colorName: colorName || null,
        colorHex: colorHex || null
      });

      document.getElementById('qsProductSearch').value = '';
      document.getElementById('qsProductDropdown').classList.add('hidden');
      renderQsCart();
    }

    function removeFromQsCart(idx) {
      qsCart.splice(idx, 1);
      renderQsCart();
    }

    function updateQsQty(idx, val) {
      const item = qsCart[idx];
      const qty = Math.max(1, Math.min(item.stock, parseInt(val) || 1));
      item.quantity = qty;
      renderQsCart();
    }

    function updateQsPrice(idx, val) {
      const raw = val.replace(/\D/g, '');
      qsCart[idx].unitPrice = raw === '' ? 0 : parseInt(raw, 10);
      updateQsTotal();
    }

    function renderQsCart() {
      const container = document.getElementById('qsCartItems');
      const wrapper = document.getElementById('qsCartContainer');

      if (!qsCart.length) {
        wrapper.classList.add('hidden');
        updateQsTotal();
        return;
      }

      wrapper.classList.remove('hidden');
      container.innerHTML = qsCart.map((item, i) => {
        const colorIndicator = item.colorName ? `<span class="w-3 h-3 rounded-full shrink-0 border border-white/20" style="background-color: ${item.colorHex || '#888'};"></span><span class="text-[10px] text-slate-400">${item.colorName}</span>` : '';
        return `
        <div class="bg-slate-800/40 border border-slate-700/30 rounded-xl p-3 space-y-2" style="animation: cardSlideUp 0.2s ease-out both">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 min-w-0 flex-1">
              <p class="text-sm font-semibold text-white truncate">${item.name}</p>
              ${colorIndicator}
            </div>
            <button onclick="removeFromQsCart(${i})" class="p-1 text-slate-500 hover:text-red-400 transition-colors shrink-0 ml-2">
              <i class="ph ph-x text-base"></i>
            </button>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex-1">
              <p class="text-[10px] text-slate-500 mb-1">Cantidad (max: ${item.stock})</p>
              <input type="number" value="${item.quantity}" min="1" max="${item.stock}" onchange="updateQsQty(${i}, this.value)" class="w-full px-3 py-2 bg-slate-900/50 border border-slate-700/50 rounded-lg text-white text-sm focus:outline-none focus:border-emerald-500/50 transition-all">
            </div>
            <div class="flex-1">
              <p class="text-[10px] text-slate-500 mb-1">Precio unit.</p>
              <input type="text" value="${item.unitPrice.toLocaleString('es-CO')}" oninput="formatCurrency(this); updateQsPrice(${i}, this.value)" class="w-full px-3 py-2 bg-slate-900/50 border border-slate-700/50 rounded-lg text-white text-sm focus:outline-none focus:border-emerald-500/50 transition-all">
            </div>
            <div class="text-right shrink-0 pt-4">
              <p class="text-sm font-bold text-white">$${(item.unitPrice * item.quantity).toLocaleString('es-CO')}</p>
            </div>
          </div>
        </div>`;        
      }).join('');

      updateQsTotal();
    }

    function updateQsTotal() {
      const total = qsCart.reduce((sum, item) => sum + (item.unitPrice * item.quantity), 0);
      document.getElementById('qsTotal').textContent = '$' + total.toLocaleString('es-CO');
      validateQsForm();
    }

    function selectPaymentMethod(method) {
      qsSelectedPayment = method;
      const colorMap = {
        'Efectivo': { border: 'border-emerald-500/50', bg: 'bg-emerald-500/10', text: 'text-emerald-400' },
        'Nequi': { border: 'border-violet-500/50', bg: 'bg-violet-500/10', text: 'text-violet-400' },
        'Daviplata': { border: 'border-orange-500/50', bg: 'bg-orange-500/10', text: 'text-orange-400' },
        'Datafono': { border: 'border-sky-500/50', bg: 'bg-sky-500/10', text: 'text-sky-400' }
      };

      document.querySelectorAll('.qs-payment-btn').forEach(btn => {
        const m = btn.dataset.method;
        btn.classList.remove('border-emerald-500/50', 'bg-emerald-500/10', 'text-emerald-400',
          'border-violet-500/50', 'bg-violet-500/10', 'text-violet-400',
          'border-orange-500/50', 'bg-orange-500/10', 'text-orange-400',
          'border-sky-500/50', 'bg-sky-500/10', 'text-sky-400');

        if (m === method) {
          const c = colorMap[method];
          btn.classList.add(c.border, c.bg, c.text);
        }
      });

      validateQsForm();
    }

    function validateQsForm() {
      const valid = qsCart.length > 0 && qsSelectedPayment;
      document.getElementById('qsSubmitBtn').disabled = !valid;
    }

    async function submitQuickSale() {
      const btn = document.getElementById('qsSubmitBtn');
      btn.disabled = true;
      btn.innerHTML = '<i class="ph ph-spinner text-lg animate-spin"></i> Procesando...';

      try {
        const payload = {
          items: qsCart.map(item => {
            const saleItem = {
              product: item.product,
              quantity: item.quantity,
              unitPrice: item.unitPrice
            };
            if (item.colorName) {
              saleItem.colorName = item.colorName;
            }
            return saleItem;
          }),
          paymentMethod: qsSelectedPayment,
          notes: document.getElementById('qsNotes').value.trim()
        };

        const res = await fetch('/api/sales', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const json = await res.json();
        if (json.success) {
          showToast('¡Venta registrada exitosamente!');
          closeQuickSale();
          // Refresh if on ventas or dashboard page
          if (typeof loadSales === 'function') loadSales();
          if (typeof loadSalesStats === 'function') loadSalesStats();
          if (typeof loadDashboard === 'function') loadDashboard();
        } else {
          showToast(json.error || 'Error al registrar venta', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="ph-fill ph-check-circle text-lg"></i> Confirmar Venta';
        validateQsForm();
      }
    }

    // Adjust FAB position on desktop (no bottom nav)
    function adjustFabPosition() {
      const fab = document.getElementById('fabQuickSale');
      if (!fab) return;
      if (window.innerWidth >= 768) {
        fab.style.bottom = '24px';
        fab.style.right = '24px';
      } else {
        fab.style.bottom = '80px';
        fab.style.right = '16px';
      }
    }
    adjustFabPosition();
    window.addEventListener('resize', adjustFabPosition);
  </script>
  <script src="/js/shared.js"></script>
  <% if (typeof pageScript !== 'undefined' && pageScript) { %>
  <script src="/js/<%= pageScript %>.js"></script>
  <% } %>
</body>
</html>
