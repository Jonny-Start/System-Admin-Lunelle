<% layout('layout') -%>
<header class="flex justify-between items-end mb-6">
  <div>
    <h2 class="text-2xl md:text-3xl font-bold text-white mb-1">Categorías</h2>
    <p class="text-slate-400 text-sm">Estructura y organiza tu catálogo</p>
  </div>
  <button onclick="openCategoryModal()" class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl px-5 py-2.5 flex items-center justify-center gap-2 shadow-lg shadow-indigo-600/30 transition-transform active:scale-95 font-medium">
    <i class="ph ph-plus text-lg"></i> Añadir
  </button>
</header>
<div id="categoryListContainer" class="grid grid-cols-1 md:grid-cols-3 xl:grid-cols-4 gap-4 mt-2">
  <div class="col-span-full flex justify-center py-20"><i class="ph ph-spinner animate-spin text-4xl text-indigo-500"></i></div>
</div>

<!-- Category Modal -->
<div id="categoryModal" class="fixed inset-0 z-50 hidden bg-slate-900/90 backdrop-blur-md flex items-end md:items-center justify-center p-0 md:p-4">
  <div class="bg-[#1e293b] w-full md:w-[450px] rounded-t-3xl md:rounded-3xl max-h-[90vh] flex flex-col transform transition-transform translate-y-full md:translate-y-0 duration-300 shadow-2xl border border-slate-700/50" id="categoryModalContent">
    <div class="px-6 py-5 border-b border-slate-700/50 flex justify-between items-center sticky top-0 bg-[#1e293b] rounded-t-3xl z-10">
      <h2 id="categoryModalTitle" class="text-xl font-bold text-white flex items-center gap-2">
        <i class="ph-fill ph-tag text-indigo-400"></i> Nueva Categoría
      </h2>
      <button onclick="closeCategoryModal()" class="p-2 bg-slate-800 rounded-full text-slate-400 hover:text-white hover:bg-slate-700 transition-colors">
        <i class="ph ph-x text-lg"></i>
      </button>
    </div>
    <form id="categoryForm" class="p-6 flex flex-col gap-5">
      <input type="hidden" id="categoryId">
      <div>
        <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Nombre de la Categoría</label>
        <input type="text" id="catName" required class="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all placeholder-slate-600" placeholder="Ej. Accesorios">
      </div>
      <div class="pt-4 flex gap-3">
        <button type="button" onclick="closeCategoryModal()" class="flex-1 py-3.5 px-4 rounded-xl font-bold text-slate-300 bg-slate-800 hover:bg-slate-700 transition-colors">Cancelar</button>
        <button type="submit" id="catSubmitBtn" class="flex-1 py-3.5 px-4 rounded-xl font-bold text-white bg-indigo-600 hover:bg-indigo-500 shadow-lg shadow-indigo-600/40 transition-transform active:scale-95 flex justify-center items-center gap-2">
          <i class="ph-bold ph-check"></i> <span>Guardar</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Category Options Bottom Sheet -->
<div id="categoryOptionsModal" class="fixed inset-0 z-50 hidden bg-slate-900/90 backdrop-blur-md flex items-end justify-center p-0 md:p-4 md:items-center">
  <div class="bg-[#1e293b] w-full md:w-[400px] rounded-t-3xl md:rounded-3xl max-h-[90vh] flex flex-col transform transition-transform translate-y-full md:translate-y-0 duration-300 shadow-2xl border border-slate-700/50" id="categoryOptionsContent">
    <div class="px-6 py-5 border-b border-slate-700/50 flex justify-between items-center sticky top-0 bg-[#1e293b] rounded-t-3xl z-10">
      <h2 class="text-xl font-bold text-white flex items-center gap-2" id="categoryOptionsTitle">
        Opciones
      </h2>
      <button onclick="closeCategoryOptions()" class="p-2 bg-slate-800 rounded-full text-slate-400 hover:text-white hover:bg-slate-700 transition-colors">
        <i class="ph ph-x text-lg"></i>
      </button>
    </div>
    <div class="p-4 flex flex-col gap-2">
      <button id="btnEditCategory" class="w-full flex items-center gap-4 p-4 rounded-2xl hover:bg-slate-800 transition-colors text-left group">
        <div class="w-10 h-10 rounded-xl bg-indigo-500/15 flex items-center justify-center text-indigo-400 group-hover:scale-110 transition-transform">
          <i class="ph-fill ph-pencil-simple text-lg"></i>
        </div>
        <div>
          <p class="text-white font-bold text-sm">Editar Categoría</p>
          <p class="text-slate-400 text-[11px] mt-0.5">Modificar el nombre</p>
        </div>
      </button>
      <button id="btnViewProducts" class="w-full flex items-center gap-4 p-4 rounded-2xl hover:bg-slate-800 transition-colors text-left group">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/15 flex items-center justify-center text-emerald-400 group-hover:scale-110 transition-transform">
          <i class="ph-fill ph-package text-lg"></i>
        </div>
        <div>
          <p class="text-white font-bold text-sm">Ver Productos</p>
          <p class="text-slate-400 text-[11px] mt-0.5">Ir al inventario filtrado</p>
        </div>
      </button>
    </div>
  </div>
</div>
