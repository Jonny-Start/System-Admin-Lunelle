<!-- VIEW: PRODUCTOS -->
      <div id="view-productos" class="view-section active">
        <header class="flex flex-col md:flex-row md:justify-between md:items-end mb-6 gap-4">
          <div>
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-1">Inventario</h2>
            <p class="text-slate-400 text-sm">Gestiona tu catálogo y controla el stock</p>
          </div>
          <button onclick="openProductModal()" class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl px-5 py-2.5 flex items-center justify-center gap-2 shadow-lg shadow-indigo-600/30 transition-transform active:scale-95 font-medium shrink-0">
            <i class="ph ph-plus text-lg"></i> Nuevo Producto
          </button>
        </header>

        <!-- Search & Filter -->
        <div class="sticky top-0 z-10 pt-2 pb-4 flex gap-3 -mx-4 px-4 md:mx-0 md:px-0 bg-transparent backdrop-blur-none">
          <div class="relative flex-1">
            <i class="ph ph-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-lg"></i>
            <input type="text" id="searchInput" placeholder="Buscar producto, SKU..." class="w-full h-[50px] bg-slate-800/60 border border-slate-700/50 rounded-2xl pl-11 pr-4 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all placeholder-slate-500 text-white shadow-inner">
          </div>
          <button onclick="openFilterModal()" class="relative h-[50px] w-[50px] bg-slate-800/60 border border-slate-700/50 rounded-2xl flex items-center justify-center text-slate-300 hover:bg-slate-700 transition-colors shadow-sm shrink-0">
            <i class="ph ph-faders text-lg"></i>
            <span id="activeFiltersBadge" class="absolute -top-1 -right-1 bg-indigo-600 text-white text-[10px] font-bold w-5 h-5 rounded-full flex items-center justify-center border-2 border-slate-900 hidden">0</span>
          </button>
        </div>

        <!-- Product List -->
        <div id="productList" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 md:gap-5 mt-2">
          <!-- Renderizado dinámicamente -->
          <div class="col-span-full flex justify-center py-20"><i class="ph ph-spinner animate-spin text-4xl text-indigo-500"></i></div>
        </div>
      </div>

      <!-- VIEW: CATEGORÍAS -->
      <div id="view-categorias" class="view-section hidden h-full">
        <header class="flex justify-between items-end mb-6">
          <div>
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-1">Categorías</h2>
            <p class="text-slate-400 text-sm">Estructura y organiza tu catálogo</p>
          </div>
          <button onclick="openCategoryModal()" class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl px-5 py-2.5 flex items-center justify-center gap-2 shadow-lg shadow-indigo-600/30 transition-transform active:scale-95 font-medium">
            <i class="ph ph-plus text-lg"></i> Añadir
          </button>
        </header>
        <div id="categoryListContainer" class="grid grid-cols-1 md:grid-cols-3 xl:grid-cols-4 gap-4 mt-2">
          <!-- Renderizado dinámicamente -->
          <div class="col-span-full flex justify-center py-20"><i class="ph ph-spinner animate-spin text-4xl text-indigo-500"></i></div>
        </div>
      </div>

      <!-- VIEW: USUARIOS -->
      <div id="view-usuarios" class="view-section hidden h-full">
        <header class="flex flex-col md:flex-row md:justify-between md:items-end mb-6 gap-4">
          <div>
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-1">Equipo de Trabajo</h2>
            <p class="text-slate-400 text-sm">Gestiona los empleados y sus accesos</p>
          </div>
          <button class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl px-5 py-2.5 flex items-center justify-center gap-2 shadow-lg shadow-indigo-600/30 transition-transform active:scale-95 font-medium shrink-0">
            <i class="ph ph-user-plus text-lg"></i> Invitar Usuario
          </button>
        </header>
        
        <div class="glass-card rounded-3xl overflow-hidden border border-slate-700/50">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-slate-800/40 border-b border-slate-700/50">
                  <th class="p-5 text-xs font-bold text-slate-400 uppercase tracking-widest">Colaborador</th>
                  <th class="p-5 text-xs font-bold text-slate-400 uppercase tracking-widest">Rol Asignado</th>
                  <th class="p-5 text-xs font-bold text-slate-400 uppercase tracking-widest">Estado</th>
                  <th class="p-5 text-xs font-bold text-slate-400 uppercase tracking-widest text-right">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-800/50">
                <tr class="hover:bg-slate-800/30 transition-colors group">
                  <td class="p-5">
                    <div class="flex items-center gap-4">
                      <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center text-white font-bold text-sm shadow-md">
                        <%= user.name.charAt(0).toUpperCase() %>
                      </div>
                      <div>
                        <p class="text-sm font-semibold text-white group-hover:text-indigo-300 transition-colors"><%= user.name %></p>
                        <p class="text-xs text-slate-500">Tú (Cuenta Actual)</p>
                      </div>
                    </div>
                  </td>
                  <td class="p-5">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-slate-800 text-slate-300 border border-slate-700/50">
                      <i class="ph-fill ph-shield-check text-indigo-400"></i> <%= user.role %>
                    </span>
                  </td>
                  <td class="p-5">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold text-emerald-400 bg-emerald-400/10 border border-emerald-400/20 uppercase tracking-wider">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Activo
                    </span>
                  </td>
                  <td class="p-5 text-right">
                    <button class="p-2 text-slate-400 hover:text-indigo-400 hover:bg-indigo-400/10 rounded-xl transition-all">
                      <i class="ph ph-pencil-simple text-lg"></i>
                    </button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- VIEW: EMPRESA -->
      <div id="view-empresa" class="view-section hidden h-full">
        <header class="mb-8">
          <h2 class="text-2xl md:text-3xl font-bold text-white mb-1">Configuración</h2>
          <p class="text-slate-400 text-sm">Administra la información pública de tu empresa</p>
        </header>
        
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="lg:col-span-1 space-y-6">
            <!-- Logo Card -->
            <div class="glass-card rounded-3xl p-6 flex flex-col items-center text-center border border-slate-700/50 relative overflow-hidden group">
              <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/5 to-transparent z-0"></div>
              <div class="w-28 h-28 rounded-3xl bg-slate-800 flex items-center justify-center text-slate-500 border border-slate-600 shadow-xl mb-4 relative z-10 group-hover:border-indigo-500/50 transition-colors">
                <i class="ph ph-buildings text-5xl group-hover:text-indigo-400 transition-colors"></i>
              </div>
              <h3 class="text-xl font-bold text-white mb-1 relative z-10">Lunele</h3>
              <p class="text-xs text-slate-400 mb-5 relative z-10">Logotipo de la empresa</p>
              <button class="relative z-10 text-xs font-bold text-indigo-400 hover:text-white hover:bg-indigo-500 px-4 py-2 rounded-xl bg-indigo-400/10 transition-all w-full border border-indigo-400/20">
                Actualizar Logo
              </button>
            </div>
          </div>

          <div class="lg:col-span-2">
            <!-- Details Card -->
            <div class="glass-card rounded-3xl p-6 md:p-8 border border-slate-700/50">
              <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
                <i class="ph-fill ph-info text-indigo-400"></i> Detalles del Negocio
              </h3>
              <form class="space-y-5">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                  <div>
                    <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Nombre Comercial</label>
                    <input type="text" value="Lunele" class="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all">
                  </div>
                  <div>
                    <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Sector / Rubro</label>
                    <input type="text" value="Comercio" class="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all">
                  </div>
                </div>
                
                <div>
                  <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Dirección Principal</label>
                  <div class="relative">
                    <i class="ph ph-map-pin absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-lg"></i>
                    <input type="text" placeholder="Ingresa la dirección completa" class="w-full bg-slate-800/50 border border-slate-700 rounded-xl pl-11 pr-4 py-3 text-sm text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all">
                  </div>
                </div>

                <div class="pt-6 mt-6 border-t border-slate-800 flex justify-end">
                  <button type="button" class="py-3 px-6 rounded-xl font-bold text-white bg-indigo-600 hover:bg-indigo-500 shadow-lg shadow-indigo-600/30 transition-transform active:scale-95">
                    Guardar Cambios
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
