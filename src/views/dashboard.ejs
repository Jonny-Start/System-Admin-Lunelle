<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Dashboard - Admin Lunele</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Phosphor Icons for modern UI icons -->
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body class="flex h-screen overflow-hidden">

  <!-- Sidebar Desktop -->
  <aside class="hidden md:flex flex-col w-64 glass-sidebar h-full z-20 shrink-0">
    <div class="p-6">
      <h1
        class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-cyan-400 flex items-center gap-2">
        <i class="ph-fill ph-moon-stars text-indigo-400"></i> Lunele
      </h1>
      <p class="text-xs text-slate-500 mt-1 uppercase tracking-widest font-semibold">Workspace</p>
    </div>

    <div class="px-4 mb-6">
      <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-800/50 border border-slate-700/50">
        <div
          class="w-10 h-10 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center text-white font-bold text-sm shrink-0 shadow-lg shadow-indigo-500/20">
          <%= user.name.charAt(0).toUpperCase() %>
        </div>
        <div class="flex-1 overflow-hidden">
          <p class="text-sm font-semibold text-white truncate">
            <%= user.name %>
          </p>
          <p class="text-xs text-indigo-300 truncate">
            <%= user.role %>
          </p>
        </div>
      </div>
    </div>

    <nav class="flex-1 space-y-1.5 px-3 overflow-y-auto no-scrollbar">
      <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-2 px-3 mt-4">Menú Principal</p>

      <button onclick="switchTab('dashboard')" id="nav-dashboard"
        class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 text-left font-medium">
        <i class="ph ph-squares-four text-xl"></i> Dashboard
      </button>
      <button onclick="switchTab('productos')" id="nav-productos"
        class="nav-item active w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 text-left font-medium">
        <i class="ph ph-package text-xl"></i> Productos
      </button>
      <button onclick="switchTab('categorias')" id="nav-categorias"
        class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 text-left font-medium">
        <i class="ph ph-tag text-xl"></i> Categorías
      </button>

      <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-2 px-3 mt-6">Administración</p>

      <button onclick="switchTab('usuarios')" id="nav-usuarios"
        class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 text-left font-medium">
        <i class="ph ph-users text-xl"></i> Usuarios
      </button>
      <button onclick="switchTab('empresa')" id="nav-empresa"
        class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 text-left font-medium">
        <i class="ph ph-buildings text-xl"></i> Empresa
      </button>
    </nav>

    <div class="p-4 border-t border-slate-800/50 mt-auto">
      <button onclick="logout()"
        class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-red-400 hover:bg-red-400/10 transition-colors text-left font-medium group">
        <i class="ph ph-sign-out text-xl group-hover:-translate-x-1 transition-transform"></i> Cerrar Sesión
      </button>
    </div>
  </aside>

  <!-- Main Content -->
  <main
    class="flex-1 flex flex-col h-full relative overflow-hidden bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-slate-800/30 via-slate-900 to-[#0f172a]">

    <!-- Topbar Mobile -->
    <header class="md:hidden flex justify-between items-center p-4 glass-nav z-20">
      <h1
        class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-cyan-400 flex items-center gap-2">
        <i class="ph-fill ph-moon-stars text-indigo-400"></i> Lunele
      </h1>
      <div class="flex items-center gap-3">
        <div
          class="w-8 h-8 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center text-white font-bold text-xs shadow-lg shadow-indigo-500/20">
          <%= user.name.charAt(0).toUpperCase() %>
        </div>
      </div>
    </header>

    <!-- Views Container -->
    <div class="flex-1 overflow-y-auto no-scrollbar p-4 md:p-8 pb-24 md:pb-8">

      <!-- VIEW: DASHBOARD -->
      <%- include('partials/view-dashboard') %>
        <!-- VIEW: PRODUCTOS -->
        <%- include('partials/view-productos') %>

    </div>

    <!-- Bottom Navigation (Mobile) -->
    <nav
      class="fixed bottom-0 left-0 right-0 glass-nav px-2 py-2 flex justify-between items-center z-40 md:hidden pb-safe border-t border-slate-800/80">
      <button onclick="switchTab('dashboard')" id="nav-mob-dashboard"
        class="nav-item-mobile flex-1 flex flex-col items-center p-2 text-slate-500 hover:text-indigo-400 transition-colors">
        <i class="ph-fill ph-squares-four text-2xl mb-1 transition-transform"></i>
        <span class="text-[10px] font-semibold">Inicio</span>
      </button>
      <button onclick="switchTab('productos')" id="nav-mob-productos"
        class="nav-item-mobile active flex-1 flex flex-col items-center p-2 text-indigo-400 transition-colors relative">
        <div class="absolute -top-1 w-8 h-1 bg-indigo-500 rounded-full"></div>
        <i class="ph-fill ph-package text-2xl mb-1 transition-transform"></i>
        <span class="text-[10px] font-semibold">Productos</span>
      </button>
      <button onclick="switchTab('categorias')" id="nav-mob-categorias"
        class="nav-item-mobile flex-1 flex flex-col items-center p-2 text-slate-500 hover:text-indigo-400 transition-colors">
        <i class="ph-fill ph-tag text-2xl mb-1 transition-transform"></i>
        <span class="text-[10px] font-semibold">Categorías</span>
      </button>
      <button onclick="switchTab('usuarios')" id="nav-mob-usuarios"
        class="nav-item-mobile flex-1 flex flex-col items-center p-2 text-slate-500 hover:text-indigo-400 transition-colors">
        <i class="ph-fill ph-users text-2xl mb-1 transition-transform"></i>
        <span class="text-[10px] font-semibold">Usuarios</span>
      </button>
      <button onclick="switchTab('empresa')" id="nav-mob-empresa"
        class="nav-item-mobile flex-1 flex flex-col items-center p-2 text-slate-500 hover:text-indigo-400 transition-colors">
        <i class="ph-fill ph-buildings text-2xl mb-1 transition-transform"></i>
        <span class="text-[10px] font-semibold">Empresa</span>
      </button>
    </nav>
  </main>

  <!-- Product Modal (Create/Edit) -->
  <div id="productModal"
    class="fixed inset-0 z-50 hidden bg-slate-900/90 backdrop-blur-md flex items-end md:items-center justify-center p-0 md:p-4">
    <div
      class="bg-[#1e293b] w-full md:w-[550px] rounded-t-3xl md:rounded-3xl max-h-[90vh] md:max-h-[85vh] flex flex-col transform transition-transform translate-y-full md:translate-y-0 duration-300 shadow-2xl border border-slate-700/50"
      id="modalContent">

      <div
        class="px-6 py-5 border-b border-slate-700/50 flex justify-between items-center sticky top-0 bg-[#1e293b] rounded-t-3xl z-40">
        <h2 id="modalTitle" class="text-xl font-bold text-white flex items-center gap-2">
          <i class="ph-fill ph-package text-indigo-400"></i> Nuevo Producto
        </h2>
        <button onclick="closeProductModal()"
          class="p-2 bg-slate-800 rounded-full text-slate-400 hover:text-white hover:bg-slate-700 transition-colors">
          <i class="ph ph-x text-lg"></i>
        </button>
      </div>

      <form id="productForm" class="p-6 overflow-y-auto no-scrollbar flex flex-col gap-5">
        <input type="hidden" id="productId">
        <input type="hidden" id="selectedCategoryId">
        <input type="hidden" id="selectedProviderId">

        <div class="flex justify-center mb-2 relative w-full px-8">
          <div id="imageDropZone" onclick="document.getElementById('productImage').click()"
            class="w-48 h-48 mx-auto rounded-3xl bg-slate-800/80 border-2 border-dashed border-slate-600 flex flex-col items-center justify-center cursor-pointer hover:border-indigo-500 hover:bg-slate-800 transition-all relative overflow-hidden group shadow-inner">
            <img id="imagePreview"
              class="absolute inset-0 w-full h-full object-cover hidden transition-transform group-hover:scale-105 z-20">

            <div id="imagePlaceholder" class="flex flex-col items-center justify-center z-10 transition-opacity">
              <i class="ph ph-camera-plus text-4xl text-slate-400 group-hover:text-indigo-400 transition-colors"></i>
              <span
                class="text-xs font-bold text-slate-400 mt-2 group-hover:text-indigo-400 uppercase tracking-wider transition-colors">Añadir
                Foto</span>
            </div>

            <div id="imageTagOverlay" onclick="event.stopPropagation(); openTagModal()"
              class="absolute top-3 left-3 right-3 z-30 flex flex-wrap gap-1 cursor-pointer pointer-events-auto">
              <span id="imageTagPlaceholder"
                class="flex items-center justify-center px-2 py-1 rounded-md shadow border border-white/20 bg-slate-900/50 hover:bg-slate-900/80 text-[10px] font-bold text-white uppercase tracking-wider backdrop-blur-md min-w-[70px] drop-shadow-md">
                <i class="ph ph-tag drop-shadow-md mr-1"></i> Etiquetas
              </span>
            </div>
            <input type="hidden" id="productTagId">
          </div>
          <input type="file" id="productImage" accept="image/*" class="hidden" onchange="previewImage(event)">
        </div>

        <div>
          <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Nombre del
            Producto</label>
          <input type="text" id="name" required
            class="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all placeholder-slate-600"
            placeholder="Ej. Camiseta Básica Negra">
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Código / SKU <span
                class="text-slate-500 font-normal lowercase">(Opcional)</span></label>
            <input type="text" id="sku"
              class="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all placeholder-slate-600"
              placeholder="SKU-001">
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Categoría</label>
            <div class="custom-select-wrapper">
              <div class="relative">
                <i class="ph ph-tag absolute left-4 top-1/2 -translate-y-1/2 text-indigo-400 text-sm"></i>
                <input type="text" id="category" required autocomplete="off"
                  class="w-full bg-slate-800/50 border border-slate-700 rounded-xl pl-10 pr-10 py-3 text-sm text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all placeholder-slate-600 cursor-text"
                  placeholder="Buscar categoría..." onfocus="openCatDropdown()"
                  oninput="document.getElementById('selectedCategoryId').value=''; filterCatDropdown(this.value)">
                <i class="ph ph-caret-down absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm pointer-events-none transition-transform"
                  id="catCaretIcon"></i>
              </div>
              <div class="custom-select-dropdown" id="catDropdown"></div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Proveedor <span
                class="text-slate-500 font-normal lowercase">(Opcional)</span></label>
            <div class="custom-select-wrapper">
              <div class="relative">
                <i class="ph ph-truck absolute left-4 top-1/2 -translate-y-1/2 text-indigo-400 text-sm"></i>
                <input type="text" id="provider" autocomplete="off"
                  class="w-full bg-slate-800/50 border border-slate-700 rounded-xl pl-10 pr-10 py-3 text-sm text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all placeholder-slate-600 cursor-text"
                  placeholder="Buscar proveedor..." onfocus="openProvDropdown()"
                  oninput="document.getElementById('selectedProviderId').value=''; filterProvDropdown(this.value)">
                <i class="ph ph-caret-down absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm pointer-events-none transition-transform"
                  id="provCaretIcon"></i>
              </div>
              <div class="custom-select-dropdown" id="provDropdown"></div>
            </div>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Descripción Corta
              <span class="text-slate-500 font-normal lowercase">(Opcional)</span></label>
            <input type="text" id="description"
              class="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all placeholder-slate-600"
              placeholder="Detalles del producto...">
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 p-4 rounded-2xl bg-slate-800/30 border border-slate-700/30">
          <div class="grid grid-cols-3 gap-3">
            <div>
              <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">Costo ($)</label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 font-medium">$</span>
                <input type="text" inputmode="numeric" id="purchasePrice" required
                  class="w-full bg-slate-800 border border-slate-700 rounded-xl pl-6 pr-3 py-3 text-sm text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all"
                  placeholder="0" oninput="formatCurrency(this); calculatePriceFromMargin()">
              </div>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">Margen (%)</label>
              <div class="relative">
                <input type="number" step="1" min="0" id="profitMargin"
                  class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all"
                  placeholder="0" oninput="preventNegative(this); calculatePriceFromMargin()">
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 font-medium">%</span>
              </div>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-indigo-400 uppercase tracking-wider mb-2">Precio de
                Venta</label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-indigo-400 font-medium">$</span>
                <input type="text" inputmode="numeric" id="salePrice" required
                  class="w-full bg-slate-800 border border-indigo-500/30 rounded-xl pl-6 pr-3 py-3 text-sm text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all shadow-[0_0_10px_rgba(99,102,241,0.1)]"
                  placeholder="0" oninput="formatCurrency(this); calculateMarginFromPrice()">
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div id="stockFieldWrapper">
            <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Stock
              Disponible</label>
            <input type="number" id="stock" min="0" required
              class="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all"
              placeholder="0" oninput="preventNegative(this)">
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Alerta Stock
              Mínimo</label>
            <input type="number" id="minStock" min="0" required
              class="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all"
              placeholder="1" oninput="preventNegative(this)">
          </div>
        </div>

        <!-- Colors Section -->
        <div class="rounded-2xl border border-slate-700/30 overflow-hidden" style="display: inline-table">
          <div class="px-4 py-3 bg-slate-800/30 flex items-center justify-between">
            <label class="text-[11px] font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2">
              <i class="ph-fill ph-palette text-indigo-400"></i> Colores Disponibles
              <span class="text-slate-500 font-normal lowercase">(Opcional)</span>
            </label>
            <button type="button" onclick="addColorRow()"
              class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-600/20 hover:bg-indigo-600/30 border border-indigo-500/30 text-indigo-400 text-[10px] font-bold uppercase tracking-wider transition-all hover:scale-105 active:scale-95">
              <i class="ph-bold ph-plus text-xs"></i> Color
            </button>
          </div>
          <div id="colorsContainer" class="p-3 space-y-2"></div>
          <div id="colorsEmptyState" class="px-4 py-3 text-center">
            <p class="text-[11px] text-slate-500 italic">Sin colores — el stock se maneja de forma general</p>
          </div>
          <div id="colorsTotalStock"
            class="hidden px-4 py-2.5 bg-slate-800/20 border-t border-slate-700/30 flex items-center justify-between">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Stock Total (suma de
              colores)</span>
            <span id="colorsTotalStockValue" class="text-sm font-bold text-indigo-400">0</span>
          </div>
        </div>
        <input type="hidden" id="productColors">

        <div class="h-5 shrink-0"></div>

        <div
          class="py-3 px-4 sticky bottom-0 bg-slate-900/80 backdrop-blur-xl mt-auto flex items-center gap-3 border-t border-slate-700/50 rounded-t-2xl rounded-b-3xl -mx-6 -mb-6">
          <button type="button" id="modalDeleteBtn" onclick="deleteProductFromModal()"
            class="hidden py-2.5 px-4 rounded-xl font-bold text-red-400 bg-red-500/10 hover:bg-red-500/20 transition-colors border border-red-500/30 shadow-sm flex items-center justify-center gap-2 shrink-0">
            <i class="ph-bold ph-trash"></i> <span>Eliminar</span>
          </button>
          <button type="button" onclick="closeProductModal()"
            class="flex-1 py-2.5 px-4 rounded-xl font-bold text-slate-300 bg-slate-800/80 hover:bg-slate-700 transition-colors border border-slate-600/50 shadow-sm">Cancelar</button>
          <button type="submit" id="submitBtn"
            class="flex-1 py-2.5 px-4 rounded-xl font-bold text-white bg-indigo-600 hover:bg-indigo-500 shadow-[0_0_15px_rgba(79,70,229,0.4)] transition-transform active:scale-95 flex justify-center items-center gap-2 border border-indigo-500/80">
            <i class="ph-bold ph-check"></i> <span>Guardar</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Category Modal -->
  <div id="categoryModal"
    class="fixed inset-0 z-50 hidden bg-slate-900/90 backdrop-blur-md flex items-end md:items-center justify-center p-0 md:p-4">
    <div
      class="bg-[#1e293b] w-full md:w-[450px] rounded-t-3xl md:rounded-3xl max-h-[90vh] flex flex-col transform transition-transform translate-y-full md:translate-y-0 duration-300 shadow-2xl border border-slate-700/50"
      id="categoryModalContent">
      <div
        class="px-6 py-5 border-b border-slate-700/50 flex justify-between items-center sticky top-0 bg-[#1e293b] rounded-t-3xl z-10">
        <h2 id="categoryModalTitle" class="text-xl font-bold text-white flex items-center gap-2">
          <i class="ph-fill ph-tag text-indigo-400"></i> Nueva Categoría
        </h2>
        <button onclick="closeCategoryModal()"
          class="p-2 bg-slate-800 rounded-full text-slate-400 hover:text-white hover:bg-slate-700 transition-colors">
          <i class="ph ph-x text-lg"></i>
        </button>
      </div>
      <form id="categoryForm" class="p-6 flex flex-col gap-5">
        <input type="hidden" id="categoryId">
        <div>
          <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Nombre de la
            Categoría</label>
          <input type="text" id="catName" required
            class="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all placeholder-slate-600"
            placeholder="Ej. Accesorios">
        </div>
        <div class="pt-4 flex gap-3">
          <button type="button" onclick="closeCategoryModal()"
            class="flex-1 py-3.5 px-4 rounded-xl font-bold text-slate-300 bg-slate-800 hover:bg-slate-700 transition-colors">Cancelar</button>
          <button type="submit" id="catSubmitBtn"
            class="flex-1 py-3.5 px-4 rounded-xl font-bold text-white bg-indigo-600 hover:bg-indigo-500 shadow-lg shadow-indigo-600/40 transition-transform active:scale-95 flex justify-center items-center gap-2">
            <i class="ph-bold ph-check"></i> <span>Guardar</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Category Options Bottom Sheet -->
  <div id="categoryOptionsModal"
    class="fixed inset-0 z-50 hidden bg-slate-900/90 backdrop-blur-md flex items-end justify-center p-0 md:p-4 md:items-center">
    <div
      class="bg-[#1e293b] w-full md:w-[400px] rounded-t-3xl md:rounded-3xl max-h-[90vh] flex flex-col transform transition-transform translate-y-full md:translate-y-0 duration-300 shadow-2xl border border-slate-700/50"
      id="categoryOptionsContent">
      <div
        class="px-6 py-5 border-b border-slate-700/50 flex justify-between items-center sticky top-0 bg-[#1e293b] rounded-t-3xl z-10">
        <h2 class="text-xl font-bold text-white flex items-center gap-2" id="categoryOptionsTitle">
          Opciones
        </h2>
        <button onclick="closeCategoryOptions()"
          class="p-2 bg-slate-800 rounded-full text-slate-400 hover:text-white hover:bg-slate-700 transition-colors">
          <i class="ph ph-x text-lg"></i>
        </button>
      </div>
      <div class="p-4 flex flex-col gap-2">
        <button id="btnEditCategory"
          class="w-full flex items-center gap-4 p-4 rounded-2xl hover:bg-slate-800 transition-colors text-left group">
          <div
            class="w-10 h-10 rounded-xl bg-indigo-500/15 flex items-center justify-center text-indigo-400 group-hover:scale-110 transition-transform">
            <i class="ph-fill ph-pencil-simple text-lg"></i>
          </div>
          <div>
            <p class="text-white font-bold text-sm">Editar Categoría</p>
            <p class="text-slate-400 text-[11px] mt-0.5">Modificar el nombre</p>
          </div>
        </button>
        <button id="btnViewProducts"
          class="w-full flex items-center gap-4 p-4 rounded-2xl hover:bg-slate-800 transition-colors text-left group">
          <div
            class="w-10 h-10 rounded-xl bg-emerald-500/15 flex items-center justify-center text-emerald-400 group-hover:scale-110 transition-transform">
            <i class="ph-fill ph-package text-lg"></i>
          </div>
          <div>
            <p class="text-white font-bold text-sm">Ver Productos</p>
            <p class="text-slate-400 text-[11px] mt-0.5">Ir al inventario filtrado</p>
          </div>
        </button>
      </div>
    </div>
  </div>

  <!-- Tag Selector Modal (inline for product) -->
  <div id="tagModal"
    class="fixed inset-0 z-[60] hidden bg-slate-900/90 backdrop-blur-md flex items-center justify-center p-4">
    <div
      class="bg-[#1e293b] w-full md:w-[350px] rounded-3xl flex flex-col shadow-2xl border border-slate-700/50 transform scale-95 opacity-0 transition-all duration-200"
      id="tagModalContent">
      <div class="px-5 py-4 border-b border-slate-700/50 flex justify-between items-center bg-[#1e293b] rounded-t-3xl">
        <h2 class="text-base font-bold text-white flex items-center gap-2">
          <i class="ph-fill ph-tag text-indigo-400"></i> Seleccionar Etiquetas
        </h2>
        <button onclick="closeTagModal()" class="text-slate-400 hover:text-white transition-colors">
          <i class="ph ph-x text-lg"></i>
        </button>
      </div>
      <div class="p-4 flex flex-col gap-2 max-h-[40vh] overflow-y-auto no-scrollbar" id="tagListContainer"></div>
      <div class="p-4 border-t border-slate-700/50 bg-slate-800/30 rounded-b-3xl flex flex-col gap-3">
        <button type="button" onclick="closeTagModal()"
          class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl font-bold transition-all shadow-lg shadow-indigo-600/30">
          Listo
        </button>
        <div class="border-t border-slate-700/50 pt-3">
          <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">Crear Nueva Etiqueta</p>
          <div class="flex gap-2">
            <input type="text" id="newTagName" placeholder="Nombre"
              class="flex-1 bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-indigo-500">
            <input type="color" id="newTagColor" value="#6366f1"
              class="w-10 h-10 p-0 border-0 rounded-xl cursor-pointer bg-transparent">
            <button type="button" onclick="createNewTag()"
              class="bg-indigo-600 text-white rounded-xl px-3 hover:bg-indigo-500 transition-colors shadow-lg shadow-indigo-600/30">
              <i class="ph-bold ph-plus"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter Modal -->
  <div id="filterModal"
    class="fixed inset-0 z-50 hidden bg-slate-900/90 backdrop-blur-md flex items-end md:items-center justify-center p-0 md:p-4">
    <div
      class="bg-[#1e293b] w-full md:w-[480px] rounded-t-3xl md:rounded-3xl max-h-[90vh] flex flex-col transform transition-transform translate-y-full md:translate-y-0 duration-300 shadow-2xl border border-slate-700/50"
      id="filterModalContent">
      <div
        class="px-6 py-5 border-b border-slate-700/50 flex justify-between items-center sticky top-0 bg-[#1e293b] rounded-t-3xl z-40">
        <h2 class="text-xl font-bold text-white flex items-center gap-2">
          <i class="ph-fill ph-faders text-indigo-400"></i> Filtros de Inventario
        </h2>
        <div class="flex items-center gap-3">
          <button onclick="clearAllFilters()"
            class="text-xs font-semibold text-slate-400 hover:text-white bg-slate-800/80 hover:bg-slate-700 px-3 py-1.5 rounded-lg border border-slate-700 transition-colors">
            Limpiar
          </button>
          <button onclick="closeFilterModal()"
            class="p-2 bg-slate-800 rounded-full text-slate-400 hover:text-white hover:bg-slate-700 transition-colors">
            <i class="ph ph-x text-lg"></i>
          </button>
        </div>
      </div>

      <div class="p-6 overflow-y-auto no-scrollbar flex flex-col gap-6" style="max-height: calc(90vh - 150px);">
        <div>
          <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2.5">Filtrar por
            Categoría</label>
          <div class="flex flex-wrap gap-2" id="filterCategoryContainer"></div>
        </div>
        <div>
          <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2.5">Filtrar por
            Proveedor</label>
          <div class="flex flex-wrap gap-2" id="filterProviderContainer"></div>
        </div>
        <div>
          <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2.5">Filtrar por
            Etiquetas</label>
          <div class="flex flex-wrap gap-2" id="filterTagContainer"></div>
        </div>
        <div>
          <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2.5">Estado del
            Stock</label>
          <div class="grid grid-cols-2 gap-2">
            <button onclick="toggleStockFilter('all')" id="stock-filter-all"
              class="stock-filter-btn py-2.5 px-4 rounded-xl text-xs font-bold text-left border flex items-center justify-between transition-all bg-indigo-500/10 border-indigo-500/80 text-indigo-400 shadow-[0_0_10px_rgba(99,102,241,0.1)]">
              <span>Todos</span>
              <i class="ph-fill ph-check-circle text-indigo-400 text-base"></i>
            </button>
            <button onclick="toggleStockFilter('inStock')" id="stock-filter-inStock"
              class="stock-filter-btn py-2.5 px-4 rounded-xl text-xs font-bold text-left border flex items-center justify-between transition-all bg-slate-800/40 border-slate-700/50 text-slate-400 hover:border-slate-600 hover:text-slate-200">
              <span>Con Stock (> 0)</span>
              <i class="ph ph-circle text-base"></i>
            </button>
            <button onclick="toggleStockFilter('outOfStock')" id="stock-filter-outOfStock"
              class="stock-filter-btn py-2.5 px-4 rounded-xl text-xs font-bold text-left border flex items-center justify-between transition-all bg-slate-800/40 border-slate-700/50 text-slate-400 hover:border-slate-600 hover:text-slate-200">
              <span>Sin Stock (Agotado)</span>
              <i class="ph ph-circle text-base"></i>
            </button>
          </div>
        </div>
        <div>
          <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2.5">Margen de Ganancia
            Mínimo (%)</label>
          <div class="relative">
            <input type="number" step="1" id="filterMarginMin"
              class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all placeholder-slate-500"
              placeholder="Ej. 15" oninput="preventNegative(this); applyCombinedFilters()">
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm font-semibold">%</span>
          </div>
        </div>
        <div>
          <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2.5">Imágenes</label>
          <div class="grid grid-cols-3 gap-2">
            <button onclick="toggleImageFilter('all')" id="image-filter-all"
              class="image-filter-btn py-2.5 px-3 rounded-xl text-xs font-bold text-center border transition-all bg-indigo-500/10 border-indigo-500/80 text-indigo-400 shadow-[0_0_10px_rgba(99,102,241,0.1)]">
              Todos
            </button>
            <button onclick="toggleImageFilter('hasImage')" id="image-filter-hasImage"
              class="image-filter-btn py-2.5 px-3 rounded-xl text-xs font-bold text-center border transition-all bg-slate-800/40 border-slate-700/50 text-slate-400 hover:border-slate-600 hover:text-slate-200">
              Con Imagen
            </button>
            <button onclick="toggleImageFilter('noImage')" id="image-filter-noImage"
              class="image-filter-btn py-2.5 px-3 rounded-xl text-xs font-bold text-center border transition-all bg-slate-800/40 border-slate-700/50 text-slate-400 hover:border-slate-600 hover:text-slate-200">
              Sin Imagen
            </button>
          </div>
        </div>
      </div>

      <div
        class="py-4 px-6 bg-slate-900/80 backdrop-blur-xl border-t border-slate-700/50 rounded-b-3xl mt-auto flex items-center gap-3">
        <button onclick="applyFilters()"
          class="w-full py-3.5 px-4 rounded-xl font-bold text-white bg-indigo-600 hover:bg-indigo-500 shadow-[0_0_15px_rgba(79,70,229,0.4)] transition-transform active:scale-95 flex justify-center items-center gap-2 border border-indigo-500/80">
          <i class="ph-bold ph-check"></i> Aplicar Filtros
        </button>
      </div>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toastContainer"
    class="fixed top-4 left-1/2 -translate-x-1/2 z-[100] flex flex-col gap-3 pointer-events-none w-full max-w-[90%] md:max-w-sm">
  </div>

  <script>
    window.userRole = '<%= user.role %>';
  </script>
  <script src="/js/dashboard.js"></script>
</body>

</html>