<% layout('layout') -%>
<header class="flex flex-col md:flex-row md:justify-between md:items-end mb-6 gap-4">
  <div>
    <h2 class="text-2xl md:text-3xl font-bold text-white mb-1">Equipo de Trabajo</h2>
    <p class="text-slate-400 text-sm">Gestiona los empleados y sus accesos en <%= user.company.name %></p>
  </div>
  <% if (user.role === 'Super Admin' || user.role === 'Administrador') { %>
  <button id="btnNewUser" class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl px-5 py-2.5 flex items-center justify-center gap-2 shadow-lg shadow-indigo-600/30 transition-transform active:scale-95 font-medium shrink-0">
    <i class="ph ph-user-plus text-lg"></i> Invitar Usuario
  </button>
  <% } %>
</header>

<div class="glass-card rounded-3xl overflow-hidden border border-slate-700/50 relative min-h-[300px]">
  <!-- Loading overlay -->
  <div id="tableLoading" class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm z-10 flex flex-col items-center justify-center hidden">
    <i class="ph ph-spinner animate-spin text-3xl text-indigo-400 mb-2"></i>
    <p class="text-slate-300 text-sm font-medium">Cargando equipo...</p>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-slate-800/40 border-b border-slate-700/50">
          <th class="p-5 text-xs font-bold text-slate-400 uppercase tracking-widest">Colaborador</th>
          <th class="p-5 text-xs font-bold text-slate-400 uppercase tracking-widest">Rol Asignado</th>
          <th class="p-5 text-xs font-bold text-slate-400 uppercase tracking-widest">Estado</th>
          <th class="p-5 text-xs font-bold text-slate-400 uppercase tracking-widest text-right">Acciones</th>
        </tr>
      </thead>
      <tbody id="usersTableBody" class="divide-y divide-slate-800/50">
        <!-- Renderizado dinámico -->
      </tbody>
    </table>
  </div>
</div>

<!-- Modal Invitar / Editar Usuario -->
<div id="userModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300">
  <div class="glass-card w-full max-w-md rounded-2xl shadow-2xl transform scale-95 transition-transform duration-300 p-6 relative">
    <button id="btnCloseModal" class="absolute top-4 right-4 text-slate-400 hover:text-white transition-colors">
      <i class="ph ph-x text-xl"></i>
    </button>
    
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-xl bg-indigo-500/20 flex items-center justify-center text-indigo-400">
        <i id="modalIcon" class="ph ph-user-plus text-xl"></i>
      </div>
      <div>
        <h3 id="modalTitle" class="text-xl font-bold text-white">Invitar Usuario</h3>
        <p id="modalSubtitle" class="text-sm text-slate-400">Agrega un nuevo colaborador</p>
      </div>
    </div>

    <form id="userForm" class="space-y-4">
      <input type="hidden" id="userId">
      
      <div id="nameContainer" class="space-y-1.5 hidden">
        <label class="text-sm font-semibold text-slate-300">Nombre</label>
        <div class="relative">
          <i class="ph ph-user absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
          <input type="text" id="userName" class="w-full bg-slate-800/50 border border-slate-700 rounded-xl py-2.5 pl-10 pr-4 text-white text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all outline-none" placeholder="Nombre (opcional)">
        </div>
      </div>

      <div class="space-y-1.5">
        <label class="text-sm font-semibold text-slate-300">Correo Electrónico</label>
        <div class="relative">
          <i class="ph ph-envelope-simple absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
          <input type="email" id="userEmail" required class="w-full bg-slate-800/50 border border-slate-700 rounded-xl py-2.5 pl-10 pr-4 text-white text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all outline-none" placeholder="ejemplo@correo.com">
        </div>
      </div>

      <div class="space-y-1.5">
        <label class="text-sm font-semibold text-slate-300">Rol</label>
        <div class="relative">
          <i class="ph ph-shield-check absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none z-10"></i>
          <select id="userRole" required class="w-full bg-slate-800/50 border border-slate-700 rounded-xl py-2.5 pl-10 pr-10 text-white text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all outline-none appearance-none cursor-pointer">
            <option value="Empleado">Empleado</option>
            <option value="Administrador">Administrador</option>
            <option value="Super Admin" id="optSuperAdmin" class="hidden">Super Admin</option>
          </select>
          <i class="ph ph-caret-down absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none"></i>
        </div>
      </div>

      <div id="inviteInfoText" class="p-3 bg-indigo-500/10 border border-indigo-500/20 rounded-xl">
        <p class="text-xs text-indigo-300 leading-relaxed">
          <i class="ph ph-info mr-1"></i> Cuando la persona inicie sesión o cree su cuenta, aparecerá debajo de <strong><%= user.company.name %></strong> y se unirá con el rol asignado.
        </p>
      </div>

      <div id="userError" class="hidden p-3 bg-red-500/10 border border-red-500/20 rounded-xl text-red-400 text-xs text-center font-medium"></div>

      <div class="pt-2 flex justify-end gap-3">
        <button type="button" id="btnCancelUser" class="px-4 py-2 rounded-xl text-slate-300 hover:bg-slate-800 font-medium transition-colors text-sm">Cancelar</button>
        <button type="submit" id="btnSaveUser" class="bg-indigo-600 hover:bg-indigo-500 text-white px-5 py-2 rounded-xl font-medium shadow-lg shadow-indigo-600/30 transition-all active:scale-95 text-sm flex items-center gap-2">
          <span>Invitar</span>
        </button>
      </div>
    </form>
  </div>
</div>
